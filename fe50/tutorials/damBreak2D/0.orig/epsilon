FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
dimensions      [0 2 -3 0 0 0 0];
internalField   uniform 1e-6;
boundaryField
{
    leftWall
    {
        type            epsilonWallFunction;
        value           uniform 1e-6;
    }
    rightWall
    {
        type            epsilonWallFunction;
        value           uniform 1e-6;
    }
    lowerWall
    {
        type            epsilonWallFunction;
        value           uniform 1e-6;
    }
    upperWall
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
