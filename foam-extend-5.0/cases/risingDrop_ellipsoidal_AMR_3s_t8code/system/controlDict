FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

libs
(
    "liblduSolvers.so"
);

application     interT8codeDyMFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         3;

deltaT          0.0005;

writeControl    adjustableRunTime;
writeInterval   0.05;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression uncompressed;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       0.01;

