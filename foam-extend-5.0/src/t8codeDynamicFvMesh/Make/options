T8CODE_DIR ?= $(HOME)/t8code

EXE_INC = \
    -std=c++17 \
    -I$(LIB_SRC)/dynamicMesh/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(T8CODE_DIR)/build/src \
    -I$(T8CODE_DIR)/src \
    -I$(T8CODE_DIR)/build/_deps/sc-build/include \
    -I$(T8CODE_DIR)/build/_deps/sc-src/src \
    -DT8_ENABLE_MPI=1 -DT8_ENABLE_MPIIO=1

LIB_LIBS = \
    -ldynamicFvMesh \
    -ldynamicMesh \
    -lmeshTools \
    -lfiniteVolume \
    -L$(T8CODE_DIR)/build/src -lt8 \
    -Wl,--disable-new-dtags \
    -Wl,-rpath,$(T8CODE_DIR)/build/src \
    -Wl,-rpath,$(T8CODE_DIR)/build/_deps/sc-build \
    -Wl,-rpath,$(T8CODE_DIR)/build/_deps/p4est-build
